; run-remom-wb-konsola - start z ikony z console=1 (okno z tekstem gry), 0.3.1
; run-remom-wb - start gry (remom) z ikony (wbstart), bez myszy
; Work:run - ReMoM z ekranem (AGA) od menu glownego: JENNY pomija intro
; (ReMoM.c: skip_intro gdy argv[1] == "JENNY"). Zrzuty klatek 60/300/900
; (REMOM_KLATKI) - okno WinUAE na tym hoscie bywa czarne, obraz dowodzimy
; od srodka. Autoinput wlaczany, gdy test polozy Work:autoinput.txt.
FailAt 1000000
Stack 1000000
CD Work:
; straznik resetu: host resetuje Amige plikiem Work:reset.flag,
; bez restartu emulatora (native/remom/straznik.c)
Delete >NIL: Work:reset.flag
Run >NIL: Work:straznik
; Workbench w tle (developer 2026-09-17: pamiec, ustawienia systemu przez
; gadzet glebi) - User-Startup dziala PRZED LoadWB z Startup-Sequence
LoadWB
; pliki gracza odlozone na czas testu (developer gra na tym samym Work:)
If NOT EXISTS Work:MAGIC.GRACZ
  Copy >NIL: Work:amiga.cfg Work:amiga.cfg-gracz
  Copy Work:MAGIC.SET Work:MAGIC.GRACZ
  Copy >NIL: Work:SAVE1.GAM Work:SAVE1.GRACZ
  Copy >NIL: Work:SAVE9.GAM Work:SAVE9.GRACZ
EndIf
; opcje gry ze wzorca - kreator nowej gry pamieta ostatnie ustawienia
Copy Work:MAGIC.ORG Work:MAGIC.SET
; ustawienia Amigi gracza (remom-prefs) nie wplywaja na test
Delete >NIL: Work:amiga.cfg
Echo >Work:amiga.cfg "console=1"
Delete >NIL: Work:mom.done
Copy Work:SAVE9.ORG Work:SAVE9.GAM
; start z ikony TAK JAK Workbench (native/remom/wbstart.c): bez CLI,
; katalog biezacy SYS:, komunikat WBStartup; stdout gry -> Work:mom-wb.log
Delete >NIL: Work:mom-wb.log Work:wb-menu.ppm
Echo >Work:autoinput.on "on"
Copy Work:autoinput-wb.txt Work:autoinput.txt
wbstart remom >Work:mom.log
Type Work:mom-wb.log >>Work:mom.log
Set PRC $RC
Why >Work:mom.why
Delete >NIL: Work:autoinput.on
; wynik testu osobno - zaraz wroca pliki gracza
Copy >NIL: Work:SAVE1.GAM Work:wynik-SAVE1.GAM
Copy >NIL: Work:SAVE9.GAM Work:wynik-SAVE9.GAM
; pliki gracza z powrotem
Copy Work:MAGIC.GRACZ Work:MAGIC.SET
Copy >NIL: Work:SAVE1.GRACZ Work:SAVE1.GAM
Copy >NIL: Work:SAVE9.GRACZ Work:SAVE9.GAM
Delete >NIL: Work:amiga.cfg
Copy >NIL: Work:amiga.cfg-gracz Work:amiga.cfg
Delete >NIL: Work:MAGIC.GRACZ Work:SAVE1.GRACZ Work:SAVE9.GRACZ Work:amiga.cfg-gracz
Echo >Work:mom.done "rc=$PRC"
